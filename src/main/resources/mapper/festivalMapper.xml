<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ichiban.ichitabi.festival.mapper.FestivalMapper">

    <!--  축제 신규 등록  -->
    <insert id="insertFestival" parameterType="festivalDto" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT  INTO    festival(title, season, content)
        VALUES          (#{title}, #{season}, #{content})
    </insert>

    <!--  계절별 축제 목록 조회  -->
    <select id="selectFestivalList" parameterType="String" resultType="festivalDto">
        SELECT  f.id,
                f.title,
                f.season,
                f.content,
                i.img_url
        FROM    festival f
            LEFT JOIN   image i
                ON  f.id    = i.owner_id
                AND i.type  = 'FESTIVAL'
                AND i.rep_img_yn = 'Y'
        WHERE   f.deleted_at IS NULL

        <if test="season != null and season != 'ALL'">
            AND f.season = #{season}
        </if>
    </select>
</mapper>